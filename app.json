{
  "expo": {
    "name": "SIPERKASA Keluarga",
    "slug": "sigap-family",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sigapfamily",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1322"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#0C1322",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.sigap.family",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C1322"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sigap.family",
      "buildNumber": "1"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
